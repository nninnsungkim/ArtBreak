{
  "name": "artbreak",
  "displayName": "ArtBreak App",
  "description": "A work of art for the moments your AI is thinking.",
  "version": "0.2.7",
  "publisher": "artwait",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nninnsungkim/ArtBreak.git"
  },
  "bugs": {
    "url": "https://github.com/nninnsungkim/ArtBreak/issues"
  },
  "homepage": "https://github.com/nninnsungkim/ArtBreak#readme",
  "icon": "media/artbreak-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "art",
    "museum",
    "met",
    "painting",
    "claude",
    "codex",
    "focus",
    "wait"
  ],
  "galleryBanner": {
    "color": "#0e0e0e",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "artbreak.pause",
        "title": "ArtBreak: Pause..."
      },
      {
        "command": "artbreak.resume",
        "title": "ArtBreak: Resume"
      },
      {
        "command": "artbreak.testWindow",
        "title": "ArtBreak: Test Window"
      },
      {
        "command": "artbreak.status",
        "title": "ArtBreak: Show Status"
      },
      {
        "command": "artbreak.resetRuntime",
        "title": "ArtBreak: Reset Runtime State"
      },
      {
        "command": "artbreak.installHooks",
        "title": "ArtBreak: Install Agent Hooks"
      },
      {
        "command": "artbreak.removeHooks",
        "title": "ArtBreak: Remove Agent Hooks"
      },
      {
        "command": "artbreak.hookStatus",
        "title": "ArtBreak: Check Hook Status"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node run-tests.mjs",
    "test:build": "tsc -p ./tsconfig.test.json",
    "test:run": "npm run test:build && npm run test",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit",
    "package:vsix": "node ./scripts/package-vsix.mjs"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "glob": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
