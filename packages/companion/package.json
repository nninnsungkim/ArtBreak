{
  "name": "artbreak-companion",
  "version": "0.2.12",
  "private": true,
  "description": "ArtBreak companion desktop application",
  "scripts": {
    "tauri": "tauri",
    "build": "tauri build",
    "dev": "tauri dev",
    "catalog:index": "node ./scripts/sync-catalog.mjs",
    "catalog:hydrate": "node ./scripts/generate-object-index.mjs && node ./scripts/sync-highlights.mjs && node ./scripts/sync-catalog.mjs",
    "test:build": "tsc -p ./tsconfig.test.json",
    "test:run": "node ../vscode-extension/run-tests.mjs",
    "test": "npm run test:build && npm run test:run",
    "lint": "echo \"Companion lint not yet implemented\"",
    "typecheck": "tsc --noEmit -p ./tsconfig.test.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^18.0.0",
    "glob": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.5.4"
  }
}
